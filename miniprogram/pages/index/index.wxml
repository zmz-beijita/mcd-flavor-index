<view class="page">
    <!-- 头部 -->
    <view class="hero">
        <view class="brand">
            <view class="logo">香</view>
            <text class="brand-name">麦门真香榜</text>
        </view>
        <text class="kicker">官方说的 vs 大家说的</text>
        <text class="title">麦当劳真香榜</text>
        <view class="stats">
            <view class="stat">
                <text class="stat-n red">{{stat.low}}</text>
                <text class="stat-l">最低真香分</text>
            </view>
            <view class="stat">
                <text class="stat-n yellow">{{stat.total}}</text>
                <text class="stat-l">真实评价</text>
            </view>
            <view class="stat">
                <text class="stat-n blue">{{stat.all}}</text>
                <text class="stat-l">在售商品</text>
            </view>
        </view>
    </view>

    <!-- 状态 -->
    <view class="state-card" wx:if="{{viewState === 'loading'}}">
        <view class="spinner"></view>
        <text class="state-title">正在加载</text>
    </view>

    <view class="state-card" wx:if="{{viewState === 'error'}}">
        <text class="state-icon">!</text>
        <text class="state-title">加载失败</text>
        <text class="state-desc">请检查后重试</text>
        <button class="btn-red retry" bindtap="handleRetry">重新加载</button>
    </view>

    <block wx:if="{{viewState === 'ready'}}">
        <!-- 真香榜 -->
        <view class="rank-hd">
            <text class="rank-t">🏆 真香榜</text>
            <text class="rank-n">{{items.length}} 个有真实评价</text>
        </view>
        <view class="rank-list">
            <view class="rk" wx:for="{{items}}" wx:key="name" bindtap="goDetail" data-name="{{item.name}}">
                <text class="rk-no">{{index + 1}}</text>
                <image class="rk-pic" src="{{item.img}}" mode="aspectFit"></image>
                <view class="rk-main">
                    <text class="rk-name">{{item.name}}</text>
                    <text class="rk-meta">n={{item.n}} 篇 · {{item.min}}–{{item.max}}★ · ¥{{item.price}}</text>
                    <view class="rk-tags">
                        <text class="rk-tag" wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this">{{tg}}</text>
                    </view>
                </view>
                <view class="rk-right">
                    <text class="rk-score {{item.scoreClass}}">{{item.avg}}</text>
                    <text class="rk-flag" wx:if="{{item.spread >= 3}}">分歧大</text>
                </view>
            </view>
        </view>

        <!-- 人气榜 -->
        <view class="rank-hd" style="margin-top:36rpx">
            <text class="rank-t">📋 人气榜</text>
            <text class="rank-n">{{hot.length}} 个在售</text>
        </view>
        <view class="rank-list">
            <view class="rk" wx:for="{{hot}}" wx:key="name" bindtap="goDetail" data-name="{{item.name}}">
                <text class="rk-no">{{index + 1}}</text>
                <image class="rk-pic" wx:if="{{item.img}}" src="{{item.img}}" mode="aspectFit"></image>
                <view class="rk-pic rk-pic-none" wx:else>
                    <text>{{item.catShort}}</text>
                </view>
                <view class="rk-main">
                    <text class="rk-name">{{item.name}}</text>
                    <text class="rk-meta">{{item.cat}} · ¥{{item.price}}</text>
                    <view class="rk-tags" wx:if="{{item.tags.length}}">
                        <text class="rk-tag rk-tag-hot" wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this">{{tg}}</text>
                    </view>
                </view>
                <view class="rk-right">
                    <text class="rk-score rk-score-none" wx:if="{{!item.hasReview}}">—</text>
                    <text class="rk-score {{item.scoreClass}}" wx:else>{{item.avg}}</text>
                    <text class="rk-flag rk-flag-grey" wx:if="{{!item.hasReview}}">待评价</text>
                </view>
            </view>
        </view>

        <view class="foot">
            <text class="foot-t">数据来源：小红书 / 什么值得买 / 大众点评 / 微信公众号 / 今日头条 / 现食研 / 新厨房</text>
            <text class="foot-t">采集于 {{collectedAt}} · 价格经麦当劳 MCP 官方核价</text>
            <text class="foot-t">非麦当劳官方产品 · 评价版权归原作者所有</text>
        </view>
    </block>
</view>
