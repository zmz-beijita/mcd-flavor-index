.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 32rpx 28rpx 64rpx;
}

/* ===== 头部 ===== */
.hero {
    margin-bottom: 32rpx;
}

.brand {
    display: flex;
    align-items: center;
}

.logo {
    width: 56rpx;
    height: 56rpx;
    border-radius: 16rpx;
    background: #e8342a;
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4rpx 0 #b32018;
}

.brand-name {
    margin-left: 16rpx;
    font-size: 30rpx;
    font-weight: 800;
}

.kicker {
    display: block;
    margin-top: 28rpx;
    color: #e8342a;
    font-size: 22rpx;
    font-weight: 800;
    letter-spacing: 3rpx;
}

.title {
    display: block;
    margin-top: 10rpx;
    font-size: 44rpx;
    font-weight: 900;
    line-height: 1.28;
    letter-spacing: -1rpx;
}

.stats {
    display: flex;
    margin-top: 26rpx;
    border: 2rpx solid #f0e4ce;
    border-radius: 24rpx;
    background: #ffffff;
    overflow: hidden;
}

.stat {
    flex: 1;
    padding: 22rpx 8rpx;
    text-align: center;
}

.stat + .stat {
    border-left: 2rpx solid #f0e4ce;
}

.stat-n {
    display: block;
    font-size: 44rpx;
    font-weight: 900;
    line-height: 1;
}

.stat-n.red { color: #e8342a; }
.stat-n.yellow { color: #dfa000; }
.stat-n.blue { color: #1cb0f6; }

.stat-l {
    display: block;
    margin-top: 8rpx;
    color: #8a7f73;
    font-size: 20rpx;
}

/* ===== 状态 ===== */
.state-card {
    display: flex;
    min-height: 300rpx;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40rpx;
    border: 2rpx solid #f0e4ce;
    border-radius: 24rpx;
    background: #ffffff;
    text-align: center;
}

.spinner {
    width: 44rpx;
    height: 44rpx;
    border: 6rpx solid #ffe9c2;
    border-top-color: #ffc72c;
    border-radius: 50%;
}

.state-icon {
    color: #e8342a;
    font-size: 56rpx;
    font-weight: 800;
}

.state-title {
    margin-top: 20rpx;
    font-size: 32rpx;
    font-weight: 700;
}

.state-desc {
    margin-top: 10rpx;
    color: #8a7f73;
    font-size: 26rpx;
}

.btn-red {
    margin-top: 28rpx;
    padding: 0 40rpx;
    background: #e8342a;
    color: #ffffff;
    font-size: 28rpx;
    font-weight: 800;
    line-height: 76rpx;
    box-shadow: 0 5rpx 0 #b32018;
}

.retry:active {
    transform: translateY(4rpx);
    box-shadow: none;
}

/* ===== 榜单卡片 ===== */
.list {
    display: flex;
    flex-direction: column;
}

.card {
    margin-bottom: 20rpx;
    padding: 22rpx 24rpx;
    border: 3rpx solid #f0e4ce;
    border-radius: 26rpx;
    background: #ffffff;
    box-shadow: 0 5rpx 0 rgba(0, 0, 0, 0.04);
}

.card-top {
    display: flex;
    align-items: center;
    margin-bottom: 14rpx;
}

.rank {
    color: #b9ada0;
    font-size: 20rpx;
    font-weight: 800;
    letter-spacing: 1rpx;
}

.flag {
    margin-left: 12rpx;
    padding: 3rpx 14rpx;
    border-radius: 999rpx;
    background: #e8342a;
    color: #ffffff;
    font-size: 19rpx;
    font-weight: 800;
}

.flag-grey {
    background: #f2ede4;
    color: #8a7f73;
}

.card-main {
    display: flex;
    align-items: center;
}

.pic {
    width: 108rpx;
    height: 108rpx;
    flex-shrink: 0;
    border-radius: 18rpx;
    background: #fdf8ee;
}

.card-info {
    flex: 1;
    min-width: 0;
    margin-left: 20rpx;
}

.name {
    display: block;
    font-size: 30rpx;
    font-weight: 800;
    line-height: 1.3;
}

.meta {
    display: block;
    margin-top: 6rpx;
    color: #8a7f73;
    font-size: 21rpx;
}

.tags {
    display: flex;
    flex-wrap: wrap;
    margin-top: 10rpx;
}

.tag {
    margin: 0 8rpx 6rpx 0;
    padding: 2rpx 10rpx;
    border: 2rpx solid #f0e4ce;
    border-radius: 999rpx;
    color: #6b6259;
    font-size: 19rpx;
}

.score-box {
    flex-shrink: 0;
    margin-left: 14rpx;
    text-align: center;
}

.score {
    display: block;
    font-size: 46rpx;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -2rpx;
}

.score.hi { color: #3cc93c; }
.score.mid { color: #dfa000; }
.score.lo { color: #e8342a; }

.score-l {
    display: block;
    margin-top: 4rpx;
    color: #b9ada0;
    font-size: 18rpx;
}

.card-foot {
    display: flex;
    align-items: center;
    margin-top: 16rpx;
    padding-top: 14rpx;
    border-top: 2rpx dashed #f0e4ce;
}

.real {
    flex: 1;
    min-width: 0;
    color: #6b6259;
    font-size: 22rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.go {
    margin-left: 10rpx;
    color: #d8cbb8;
    font-size: 32rpx;
}

/* ===== 页脚 ===== */
.foot {
    margin-top: 16rpx;
    padding: 22rpx 8rpx;
}

.foot-t {
    display: block;
    color: #b9ada0;
    font-size: 20rpx;
    line-height: 1.9;
}

/* ===== 排行榜 ===== */
.rank-hd {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 16rpx;
}

.rank-t {
    font-size: 30rpx;
    font-weight: 900;
}

.rank-n {
    color: #b9ada0;
    font-size: 21rpx;
    font-weight: 700;
}

.rank-list {
    display: flex;
    flex-direction: column;
}

.rk {
    display: flex;
    align-items: center;
    margin-bottom: 12rpx;
    padding: 16rpx 18rpx;
    border: 3rpx solid #f0e4ce;
    border-radius: 22rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.03);
}

.rk-no {
    width: 46rpx;
    flex-shrink: 0;
    color: #b9ada0;
    font-size: 24rpx;
    font-weight: 800;
    text-align: center;
}

.rk-pic {
    width: 84rpx;
    height: 84rpx;
    flex-shrink: 0;
    margin-left: 8rpx;
    border-radius: 16rpx;
    background: #fff6e9;
}

.rk-pic-none {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #c9c0b2;
    font-size: 19rpx;
    font-weight: 700;
    text-align: center;
}

.rk-main {
    flex: 1;
    min-width: 0;
    margin-left: 16rpx;
}

.rk-name {
    display: block;
    font-size: 27rpx;
    font-weight: 800;
    line-height: 1.3;
}

.rk-meta {
    display: block;
    margin-top: 4rpx;
    color: #8a7f73;
    font-size: 21rpx;
}

.rk-tags {
    display: flex;
    flex-wrap: wrap;
    margin-top: 8rpx;
}

.rk-tag {
    margin: 0 8rpx 6rpx 0;
    padding: 2rpx 12rpx;
    border: 2rpx solid #f0e4ce;
    border-radius: 999rpx;
    color: #6b6259;
    font-size: 19rpx;
    font-weight: 700;
}

.rk-tag-hot {
    border-color: #ffc72c;
    background: #ffc72c;
    color: #2b2520;
}

.rk-right {
    flex-shrink: 0;
    margin-left: 12rpx;
    text-align: right;
}

.rk-score {
    display: block;
    font-size: 38rpx;
    font-weight: 900;
    line-height: 1;
}

.rk-score.hi { color: #3cc93c; }
.rk-score.mid { color: #dfa000; }
.rk-score.lo { color: #e8342a; }
.rk-score.none { color: #c9c0b2; font-size: 30rpx; }

.rk-flag {
    display: inline-block;
    margin-top: 6rpx;
    padding: 2rpx 10rpx;
    border-radius: 999rpx;
    background: #e8342a;
    color: #ffffff;
    font-size: 18rpx;
    font-weight: 800;
}

.rk-flag-grey {
    background: #f2ede4;
    color: #8a7f73;
}
