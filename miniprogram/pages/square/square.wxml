<view class="page">
    <view class="head">
        <text class="kicker">麦门广场</text>
        <text class="title">大家都在说</text>
        <view class="filters">
            <view class="f {{filter === 'all' ? 'on' : ''}}" data-f="all" bindtap="setFilter">全部</view>
            <view class="f {{filter === 'good' ? 'on' : ''}}" data-f="good" bindtap="setFilter">真香</view>
            <view class="f {{filter === 'bad' ? 'on' : ''}}" data-f="bad" bindtap="setFilter">踩雷</view>
        </view>
    </view>

    <!-- 就地发帖：选商品 + 投票 + 写理由 -->
    <view class="postbox">
        <text class="pb-hd">✍️ 写一句你的判断</text>
        <picker class="pb-picker" mode="selector" range="{{itemNames}}" value="{{itemIndex}}" bindchange="onPickItem">
            <view class="pb-picker-in">
                <text class="pb-picker-t">{{pickName || '选一个商品'}}</text>
                <text class="pb-arrow">▾</text>
            </view>
        </picker>
        <view class="pb-votes">
            <view class="pbv good {{vote === 'good' ? 'on' : ''}}" data-v="good" bindtap="onPickVote">真香</view>
            <view class="pbv mid {{vote === 'mid' ? 'on' : ''}}" data-v="mid" bindtap="onPickVote">一般</view>
            <view class="pbv bad {{vote === 'bad' ? 'on' : ''}}" data-v="bad" bindtap="onPickVote">踩雷</view>
        </view>
        <textarea class="pb-text" placeholder="为什么？比如：芝士棒是空心的，只有面粉皮子" maxlength="60" value="{{reason}}" bindinput="onReason"></textarea>
        <button class="pb-btn" bindtap="submitPost">发到广场</button>
        <text class="pb-tip {{tipOk ? 'ok' : ''}}" wx:if="{{tip}}">{{tip}}</text>
    </view>

    <view class="feed">
        <view class="post" wx:for="{{flow}}" wx:key="id">
            <view class="post-hd">
                <view class="badge {{item.vote}}">{{item.voteLabel}}</view>
                <text class="post-item">{{item.item}}</text>
                <text class="post-mine" wx:if="{{item.mine}}">我</text>
            </view>
            <text class="post-text">{{item.text}}</text>
            <view class="post-ft">
                <text class="post-src" wx:if="{{item.source}}">— {{item.source}}</text>
                <text class="post-src" wx:else>— 我的投票</text>
                <text class="post-num" wx:if="{{item.n}}">n={{item.n}}</text>
            </view>
        </view>
    </view>

    <view class="empty" wx:if="{{flow.length === 0}}">
        <text class="empty-t">还没有人投票</text>
        <text class="empty-d">在上方写下你的判断，它会立刻出现在这里</text>
    </view>

    <view class="foot">
        <text class="foot-t">种子内容来自 49 篇真实公开评价（含来源标注）；你的投稿只存在本机。</text>
        <text class="foot-t">非麦当劳官方产品 · 评价版权归原作者所有</text>
    </view>
</view>
