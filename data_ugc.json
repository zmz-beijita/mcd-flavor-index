      "official_price_yuan": 23.5,
      "ugc": [
        {
          "score": 5,
          "text": "清爽担当，不那么罪恶的汉堡。煎烤鸡肉，油腻感比麦辣低不少。想吃汉堡又怕太油就选它。",
          "source": "小红书测评"
        },
        {
          "score": 4,
          "text": "酱汁微甜咸口，鸡腿肉嫩滑带有胡椒辣味，面包带有奶香。",
          "source": "什么值得买"
        },
        {
          "score": 3,
          "text": "必须趁热食用，放久后肉变柴、面包吸油，体验断崖式下跌。",
          "source": "什么值得买"
        },
        {
          "score": 4,
          "text": "口感嫩滑，但特制酱汁提升了整体味道，酱汁较多可能导致最后几口有些腻。",
          "source": "什么值得买"
        },
        {
          "score": 5,
          "text": "里面有一整款烤制后的鸡腿肉，鸡皮还存在，入口油香四溢，鸡肉的肉汁充斥口腔，非常美味的一款汉堡。这个被众多麦友们认为是麦当劳里的顶级单品。",
          "source": "微信公众号测评"
        },
        {
          "score": 4,
          "text": "双面煎炉工艺制作而成的汉堡，不额外加油，煎熟鸡腿所提供的油脂是鸡腿本身所含的油脂。含钠量较高，大约在1174毫克左右，吃完第二天容易水肿。",
          "source": "公众号营养测评"
        },
        {
          "score": 5,
          "text": "号称 0 油添加板烧鸡腿堡，对标隔壁奥尔良鸡腿堡。煎的鸡腿肉鲜嫩多汁+沙拉酱+脆生菜，是解腻标配。",
          "source": "微信公众号测评"
        }
      ],
      "cat": "口味类",
      "real": [
        "清爽不油腻",
        "必须趁热吃",
        "钠高易水肿"
      ]
